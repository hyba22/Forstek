{
  "name": "forstek",
  "version": "1.0.0",
  "description": "Full-stack application with React frontend and Node.js backend",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm install && npm run dev",
    "dev:backend": "cd server && npm start",
    "start": "npm run dev:backend",
    "build": "cd frontend && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyba22/Forstek/"
  },
  "keywords": [
    "fullstack",
    "react",
    "node",
    "nestjs"
  ],
  "author": "team Forstek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hyba22/Forstek/"
  },
  "homepage": "https://github.com/hyba22/Forstek/",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^8.2.2",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.0",
    "@types/multer": "^1.4.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "multer": "^1.4.5-lts.2",
    "package.json": "^2.0.1",
    "react-modal": "^3.16.3"
  }
}
